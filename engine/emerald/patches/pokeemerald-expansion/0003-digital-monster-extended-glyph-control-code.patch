From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Add 16-bit Digital Monster Japanese glyph escape

Target: rh-hideout/pokeemerald-expansion
Ref: 75b806a3ab57a81ff1eb6179288981f0b3cc3050

The existing renderer already carries glyph IDs in u16 and supports an
EXT_CTRL_CODE_ESCAPE path into the 0x100 range. Digital_Monster_Series needs
642 additional characters for the current official Japanese entity and
technique names, including 600 Han characters.

Reserve EXT_CTRL_CODE 0x1D. Its payload is a little-endian u16 glyph ID.
Generated charmap entries encode the new glyphs as:
    FC 1D <lo> <hi>

This patch provides the parser/render hook. The extended glyph atlas must be
appended/generated separately before enabling the profile.

diff --git a/include/constants/characters.h b/include/constants/characters.h
--- a/include/constants/characters.h
+++ b/include/constants/characters.h
@@
 #define EXT_CTRL_CODE_TEXT_COLORS            0x1C
+#define EXT_CTRL_CODE_DM_GLYPH               0x1D

diff --git a/src/text.c b/src/text.c
--- a/src/text.c
+++ b/src/text.c
@@
             case EXT_CTRL_CODE_ESCAPE:
                 currChar = *textPrinter->printerTemplate.currentChar | 0x100;
                 textPrinter->printerTemplate.currentChar++;
                 break;
+            case EXT_CTRL_CODE_DM_GLYPH:
+                currChar = *textPrinter->printerTemplate.currentChar++;
+                currChar |= *textPrinter->printerTemplate.currentChar++ << 8;
+                textPrinter->japanese = TRUE;
+                break;
@@
             case EXT_CTRL_CODE_ESCAPE:
                 ++strPos;
                 break;
+            case EXT_CTRL_CODE_DM_GLYPH:
+                strPos += 2;
+                ++width;
+                break;
@@
             case EXT_CTRL_CODE_JPN:
                 isJapanese = 1;
                 break;
             case EXT_CTRL_CODE_ENG:
                 isJapanese = 0;
                 break;
+            case EXT_CTRL_CODE_DM_GLYPH:
+                {
+                    u16 glyphId = *++str;
+                    glyphId |= *++str << 8;
+                    glyphWidth = func(glyphId, TRUE);
+                    if (minGlyphWidth > 0 && glyphWidth < minGlyphWidth)
+                        glyphWidth = minGlyphWidth;
+                    lineWidth += glyphWidth;
+                    if (str[1] != EOS)
+                        lineWidth += localLetterSpacing;
+                }
+                break;
@@
             case EXT_CTRL_CODE_ESCAPE:
                 ++strPos;
                 break;
+            case EXT_CTRL_CODE_DM_GLYPH:
+                {
+                    u16 glyphId = strLocal[strPos++];
+                    glyphId |= strLocal[strPos++] << 8;
+                    switch (fontId)
+                    {
+                    case FONT_BOLD:
+                        DecompressGlyph_Bold(glyphId);
+                        break;
+                    case FONT_NORMAL:
+                    default:
+                        DecompressGlyph_Normal(glyphId, TRUE);
+                        break;
+                    }
+                    CpuCopy32(gCurGlyph.gfxBufferTop, pixels, 0x20);
+                    CpuCopy32(gCurGlyph.gfxBufferBottom, pixels + 0x20, 0x20);
+                    pixels += 0x40;
+                    continue;
+                }
