From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Append Digital Monster techniques to Emerald move catalog

Target: rh-hideout/pokeemerald-expansion
Ref: 75b806a3ab57a81ff1eb6179288981f0b3cc3050

Keep the engine/Pokemon move constants 0..934 because battle code references
them internally. Append the 2,557 Digital Monster techniques at 935..3491.
This still fits the 12-bit persistent move storage patch (max 4095).

Generated files copied into the engine checkout:
- include/constants/digital_monster_move_enum.inc
- src/data/digital_monster/moves_info.inc

diff --git a/include/constants/moves.h b/include/constants/moves.h
--- a/include/constants/moves.h
+++ b/include/constants/moves.h
@@
-    MOVES_COUNT_ALL = MOVES_COUNT_DYNAMAX,
+#ifdef DIGITAL_MONSTER_SERIES
+#include "constants/digital_monster_move_enum.inc"
+    MOVES_COUNT_ALL = DM_MOVES_COUNT,
+#else
+    MOVES_COUNT_ALL = MOVES_COUNT_DYNAMAX,
+#endif
 };

diff --git a/src/data/moves_info.h b/src/data/moves_info.h
--- a/src/data/moves_info.h
+++ b/src/data/moves_info.h
@@
     [MOVE_G_MAX_RAPID_FLOW] =
     {
@@
         .battleAnimScript = gBattleAnimMove_GMaxRapidFlow,
     },
+#ifdef DIGITAL_MONSTER_SERIES
+#include "digital_monster/moves_info.inc"
+#endif
 };
