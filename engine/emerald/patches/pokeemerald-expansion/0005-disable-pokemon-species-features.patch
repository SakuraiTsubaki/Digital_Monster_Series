+#undef P_FOOTPRINTS
+#undef P_CRIES_ENABLED
+#define P_GENDER_DIFFERENCES FALSE
+#define P_CUSTOM_GENDER_DIFF_ICONS FALSE
+#define P_FOOTPRINTS FALSE
